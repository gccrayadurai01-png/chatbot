# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the sales conversation
CHAT_MODEL=claude-opus-4-8

# Model used for background lead extraction (runs once per assistant turn).
# claude-haiku-4-5 is the cheap option if extraction cost matters to you.
EXTRACTION_MODEL=claude-opus-4-8

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudsufi_chatbot

# Admin auth — generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# Optional: comma-separated list of allowed widget origins. Empty = same-origin only.
ALLOWED_ORIGINS=
